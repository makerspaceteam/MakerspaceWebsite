# Copy to .env and fill in — used by docker-compose.yml for the backend service.
# Same values as backend/.env.example; see that file for details on each.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single public domain this stack is served from.
# Frontend and API share this origin, so CORS_ORIGIN and FRONTEND_URL match it.
CORS_ORIGIN=https://makerspace.idri.edu.kh
FRONTEND_URL=https://makerspace.idri.edu.kh
VITE_BACKEND_URL=https://makerspace.idri.edu.kh

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common
# Must exactly match a redirect URI configured on the Azure app registration.
MICROSOFT_REDIRECT_URI=http://makerspace.idri.edu.kh/api/auth/microsoft/callback
MICROSOFT_ALLOWED_EMAIL_DOMAIN=cadt.edu.kh
